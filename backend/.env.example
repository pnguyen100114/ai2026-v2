# Copy thành backend/.env khi chạy local; trên Render/Railway nhập vào Environment Variables.
# TUYỆT ĐỐI không commit file .env thật lên GitHub.

GEMINI_API_KEY=
# Model rẻ nhất vẫn giảng tốt VÀ vẫn trích dẫn [1] (trích dẫn là thứ tạo nút "Xem trang").
# $0,25 input / $1,50 output mỗi 1M token. So sánh: gemini-3.5-flash là $1,50 / $9,00 — đắt
# hơn ~6 lần cho cùng một câu trả lời. Nếu thấy giảng chưa đủ sâu thì nâng lên
# gemini-3.5-flash-lite. Đừng dùng gemini-2.5-flash-lite: rẻ hơn nhưng project mới gọi bị 404.
GEMINI_MODEL=gemini-3.1-flash-lite
# Hết quota model chính (gói miễn phí) thì tự thử lần lượt các model này.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Giới hạn độ dài câu trả lời. Output bị tính tiền gấp 4-25 lần input nên đây là nút
# tiết kiệm mạnh nhất: một câu trả lời lan ra 3.000 token tốn gấp 4 lần câu vừa đủ.
MAX_OUTPUT_TOKENS=800
# Riêng câu trả lời dạng JSON (quiz, lộ trình) cần nhiều hơn: JSON bị cắt là không parse được,
# tức mất luôn cả câu trả lời chứ không phải chỉ ngắn đi.
MAX_JSON_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Giọng đọc "Nghe giảng" (Microsoft Edge neural voice). Giọng nam: vi-VN-NamMinhNeural
TTS_VOICE=vi-VN-HoaiMyNeural

# Kho vector SGK nằm trong chính DATABASE_URL ở cuối file này (bảng sgk_chunks), không còn
# dịch vụ ngoài nào nữa — xem backend/rag/vector_store.py. Không có key để điền ở đây cả.

# --- Nạp sách (chỉ dùng khi chạy backend/rag/ingest.py) ---
# Gói miễn phí Gemini đếm MỖI TEXT trong batch là 1 request, trần 100 text/phút.
# Bật billing (Tier 1) thì nâng số này lên để nạp nhanh hơn nhiều.
EMBED_RPM=100
EMBED_BATCH_SIZE=50
# Chunk to hơn = ít vector hơn, ít token hơn. Đổi số này thì phải nạp lại sách (--force).
CHUNK_SIZE=1800
CHUNK_OVERLAP=200

# --- Trần số kết quả mỗi lần tìm kiếm ---
# Đọc kho vector giờ không mất tiền, nhưng mỗi kết quả kèm ~2 KB text đi thẳng vào prompt
# gửi Gemini, mà token đầu vào thì vẫn tính tiền. Tăng số này là mỗi câu hỏi đắt lên.
RAG_MAX_TOP_K=24
CURRICULUM_CACHE_TTL=3600

# --- Ảnh trang SGK (Supabase Storage) ---
# 2,1 GB PDF trong backend/data không đẩy lên GitHub được, nên khi deploy backend không có gì
# để render nút "Xem trang". Chạy `python backend/rag/render_pages.py` một lần ở máy có PDF để
# render sẵn 3.609 trang thành JPEG rồi upload lên đây (633 MB, vừa gói free 1 GB).
# Để trống khi chạy local → backend tự render thẳng từ PDF như cũ.
# Lấy ở Supabase → Project Settings → API. SERVICE_KEY là "service_role", TUYỆT ĐỐI không đưa
# vào frontend hay commit lên GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PAGE_BUCKET=sgk-pages
# Số giây link ảnh còn hiệu lực. Trình duyệt tải ảnh ngay nên không cần dài.
PAGE_URL_TTL=3600
# Chỉ dùng lúc chạy render_pages.py. Đổi thì phải render lại (--force).
# 1.0x = 633 MB cả bộ (số đo thật); 1.2x ≈ 802 MB nét hơn; 0.8x ≈ 422 MB nếu cần tiết kiệm.
PAGE_RENDER_SCALE=1.0
PAGE_RENDER_QUALITY=72
PAGE_UPLOAD_WORKERS=6

# Database. Để trống khi chạy local → tự dùng SQLite (backend/local.db).
# Khi deploy: chuỗi Postgres miễn phí (Supabase "Session pooler" hoặc Neon), ví dụ:
# DATABASE_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Khóa ký token đăng nhập. BẮT BUỘC đặt khi deploy (chuỗi ngẫu nhiên dài), nếu đổi thì mọi người bị đăng xuất.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Domain frontend được phép gọi API, cách nhau dấu phẩy. Ví dụ: https://gia-su-ai.vercel.app
ALLOWED_ORIGINS=*
# Số proxy đứng trước backend có thêm IP vào header X-Forwarded-For. Local: 0. Render/Railway: 1.
# Đặt sai (lớn hơn thực tế) thì kẻ xấu có thể giả IP để né giới hạn số lần đăng nhập.
TRUSTED_PROXY_HOPS=0
# Giới hạn số câu hỏi mỗi học sinh để bảo vệ quota Gemini.
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=200
