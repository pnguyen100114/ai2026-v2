# Copy thành backend/.env khi chạy local; trên Render/Railway nhập vào Environment Variables.
# TUYỆT ĐỐI không commit file .env thật lên GitHub.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Hết quota model chính (gói miễn phí) thì tự thử lần lượt các model này.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Giọng đọc "Nghe giảng" (Microsoft Edge neural voice). Giọng nam: vi-VN-NamMinhNeural
TTS_VOICE=vi-VN-HoaiMyNeural

PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=

# Database. Để trống khi chạy local → tự dùng SQLite (backend/local.db).
# Khi deploy: chuỗi Postgres miễn phí (Supabase "Session pooler" hoặc Neon), ví dụ:
# DATABASE_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Khóa ký token đăng nhập. BẮT BUỘC đặt khi deploy (chuỗi ngẫu nhiên dài), nếu đổi thì mọi người bị đăng xuất.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Domain frontend được phép gọi API, cách nhau dấu phẩy. Ví dụ: https://gia-su-ai.vercel.app
ALLOWED_ORIGINS=*
# Số proxy đứng trước backend có thêm IP vào header X-Forwarded-For. Local: 0. Render/Railway: 1.
# Đặt sai (lớn hơn thực tế) thì kẻ xấu có thể giả IP để né giới hạn số lần đăng nhập.
TRUSTED_PROXY_HOPS=0
# Giới hạn số câu hỏi mỗi học sinh để bảo vệ quota Gemini.
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=200
